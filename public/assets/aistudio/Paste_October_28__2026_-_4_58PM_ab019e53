// Envia a chave de acesso do CRM em todas as chamadas para /api do próprio site.
// A chave é digitada uma vez por navegador e fica guardada aqui.
export const ACCESS_KEY_STORAGE = 'conversa_crm_access_key';
export const ACCESS_KEY_EVENT = 'crm-access-key-required';

export function getAccessKey() {
  try { return localStorage.getItem(ACCESS_KEY_STORAGE) || ''; } catch { return ''; }
}

export function setAccessKey(key: string) {
  localStorage.setItem(ACCESS_KEY_STORAGE, key.trim());
