                      <Bar dataKey="enviadas" name="Enviadas" fill="#16A34A" radius={[4, 4, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
              )}
            </Box>
          </div>
        </div>
      )}
    </div>
  );
};
